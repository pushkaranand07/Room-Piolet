# Project Configuration
PROJECT_NAME="RoomPilot"
PYTHONPATH="./src"

# Flask Configuration
FLASK_APP="src.app"
FLASK_PORT="5001"
FLASK_HOST="127.0.0.1"
FLASK_DEBUG="1"
FLASK_ENV="development"
FLASK_SECRET_KEY="your-secret-key-here"


# LLM provider configuration
# Use "fake" for frontend development and tests.
# Use "gemini" for live verification.
GROQ_API_KEY="your-secret-key-here"
GROQ_MODEL_NAME="openai/gpt-oss-20b"
LLM_PROVIDER="fake"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_NAME="gemini-3.6-flash"
TEMPERATURE="0.0"
# "meta-llama/llama-4-scout-17b-16e-instruct"
# "deepseek-r1-distill-llama-70b" # "llama-3.1-8b-instant" # "llama3-8b-8192" # "mistral-saba-24b"

# Optional tracing is disabled so the application remains local by default.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT=""
LANGCHAIN_API_KEY=""

